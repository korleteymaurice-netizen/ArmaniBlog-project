<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Post - ArmaniBlog</title>

    <link rel="stylesheet" href="/styles.css">

</head>

<body>

    <header class="navbar">

        <div class="container nav-content">

            <a href="/" class="logo">
                ArmaniBlog
            </a>

            <a href="/" class="btn btn-secondary">
                Back Home
            </a>

        </div>

    </header>


    <main class="container">

        <section class="form-container">

            <h1>Edit Post</h1>


            <form
                action="/edit/<%= post.id %>"
                method="POST"
            >

                <div class="form-group">

                    <label for="title">
                        Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= post.title %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="content">
                        Content
                    </label>

                    <textarea
                        id="content"
                        name="content"
                        required
                    ><%= post.content %></textarea>

                </div>


                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Save Changes
                </button>

            </form>

        </section>

    </main>

</body>
</html>